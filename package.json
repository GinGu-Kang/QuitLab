{
  "name": "quit-codex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run seed && npm run verify:repo && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx scripts/seed-from-excel.ts",
    "import:master-data": "tsx scripts/import-master-data-from-json.ts",
    "validate:master-data": "tsx scripts/validate-master-data-release.ts",
    "preview:release-diff": "tsx scripts/preview-release-diff.ts",
    "test": "npm run verify:repo && vitest run",
    "test:watch": "vitest",
    "verify:repo": "node scripts/verify-required-paths.cjs",
    "notify:send": "node scripts/send-imessage.cjs",
    "notify:test": "node scripts/send-imessage.cjs --message \"Quit-codex 테스트 메시지입니다. 개발 완료 알림 설정이 정상 동작하면 이 문자가 도착합니다.\"",
    "notify:done": "node scripts/dev-complete-notify.cjs",
    "notify:telegram:send": "node scripts/send-telegram.cjs",
    "notify:telegram:test": "node scripts/send-telegram.cjs --message \"Quit-codex 텔레그램 테스트 메시지입니다. 개발 완료 알림 설정이 정상 동작하면 이 메시지가 도착합니다.\"",
    "notify:telegram:updates": "node scripts/get-telegram-updates.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@supabase/supabase-js": "^2.49.4",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.503.0",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "recharts": "^2.15.3",
    "resend": "^4.3.0",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "playwright": "^1.59.1",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
